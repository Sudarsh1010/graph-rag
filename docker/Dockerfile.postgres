# Multi-stage build: PostgreSQL 16 + Apache AGE + pgvector
#
# PRIMARY BUILD (requires DNS in Docker build):
#   docker compose build postgres
#
# FALLBACK (when Docker build DNS is broken):
#   ./scripts/build-postgres-image.sh
#
# The script builds AGE + pgvector in a running container with --dns,
# then exports a clean image that docker-compose uses.

# ── Stage 1: Build Apache AGE ──────────────────────────────────
FROM postgres:16-bookworm AS age-builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    postgresql-server-dev-16 \
    libreadline-dev \
    zlib1g-dev \
    flex \
    bison \
    && rm -rf /var/lib/apt/lists/*

# Build AGE from source (PG16/v1.5.0-rc0 is compatible with PostgreSQL 16)
RUN git clone --branch PG16/v1.5.0-rc0 --depth 1 https://github.com/apache/age.git /tmp/age \
    && cd /tmp/age \
    && make PG_CONFIG=/usr/lib/postgresql/16/bin/pg_config \
    && make install PG_CONFIG=/usr/lib/postgresql/16/bin/pg_config

# ── Stage 2: Final image ───────────────────────────────────────
FROM postgres:16-bookworm

# Install pgvector from Debian packages (available in bookworm)
RUN apt-get update && apt-get install -y --no-install-recommends \
    postgresql-16-pgvector \
    && rm -rf /var/lib/apt/lists/*

# Copy AGE shared library and extension files from builder
COPY --from=age-builder /usr/lib/postgresql/16/lib/age.so /usr/lib/postgresql/16/lib/
COPY --from=age-builder /usr/share/postgresql/16/extension/age* /usr/share/postgresql/16/extension/

# Configure PostgreSQL to load AGE on startup
RUN echo "shared_preload_libraries = 'age'" >> /usr/share/postgresql/postgresql.conf.sample

# Initialize script: create extensions for every new database
# This runs via docker-entrypoint-initdb.d
RUN mkdir -p /docker-entrypoint-initdb.d
COPY init-extensions.sql /docker-entrypoint-initdb.d/00-init-extensions.sql
